# ============================================
# NagrikSeva AI - Environment Variables
# ============================================
# Copy this file to .env.local and fill values

# ── Gemini AI ──────────────────────────────
GOOGLE_GENAI_API_KEY=your_gemini_api_key_here

# ── Firebase Client (Public - safe to expose) ──
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# ── Firebase Admin (Secret - server only) ──
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your_project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# ── App ────────────────────────────────────
NEXT_PUBLIC_APP_NAME=NagrikSeva AI
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Cryptographic Session Secret (P0 Admin Authorization, min 32 chars) ──
OFFICER_AUTH_SECRET=your_random_32_char_cryptographic_secret_here

# ── Hackathon Demo Credentials Mode ──
# Set to "true" to enable synthetic demo PIN (GJ2026) for officer 1-click login
ALLOW_DEMO_CREDENTIALS=true
NEXT_PUBLIC_ALLOW_DEMO_CREDENTIALS=true

# ── Razorpay Payment Gateway & Webhook Config ──
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
PAYMENT_WEBHOOK_SECRET=your_razorpay_webhook_secret_here